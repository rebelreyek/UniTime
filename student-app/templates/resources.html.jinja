{% extends 'base.html.jinja' %}

{% block title %}Resources{% endblock %}

{% block content %}
  <div class="columns is-multiline">
    {% for item in resources %}
      <div class="column is-one-third">
        <a class="box has-text-dark" href="{{ item.url }}" target="_blank" rel="noopener noreferrer" style="height: 100%; display: block; text-decoration: none;">
          <h2 class="title is-5 montserrat">{{ item.title }}</h2>
          <p>{{ item.description }}</p>
        </a>
      </div>
    {% endfor %}
  </div>
{% endblock %}
