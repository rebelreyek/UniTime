<!doctype html>

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Unitime - {% block title %}{% endblock %}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital@0;1&family=Roboto&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@1.0.2/css/bulma.min.css"
    integrity="sha256-efrxyTTvKJ2Q1/BD8p9dZFtTEcil+cMzxZeL/7hdO2g=" crossorigin="anonymous">
  <style>
    :root {
      color-scheme: light dark;
    }

    body {
      color-scheme: light dark;
    }

    .roboto-regular {
      font-family: "Roboto", sans-serif;
      font-weight: 400;
      font-style: normal;
    }

    .montserrat {
      font-family: "Montserrat", sans-serif;
      font-optical-sizing: auto;
      font-weight: 600;
      font-style: normal;
    }

    body,
    p,
    li,
    td,
    th,
    label,
    input,
    button,
    a,
    span {
      font-weight: 500;
    }

    .box,
    .resource-card,
    .card {
      background-color: white;
      color: #0f172a;
      border: 1px solid #dbdbdb;
      border-radius: 0.75rem;
      transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    }

    .box:hover,
    .resource-card:hover,
    .card:hover {
      background-color: #f8f9fb;
      border-color: #b5b5b5;
    }

    .box *,
    .resource-card *,
    .card * {
      color: inherit;
    }

    @media (prefers-color-scheme: dark) {
      .box,
      .resource-card,
      .card {
        background-color: #1f1f1f;
        color: #f5f5f5;
        border-color: #3a3a3a;
      }

      .box:hover,
      .resource-card:hover,
      .card:hover {
        background-color: #2b2b2b;
        border-color: #4a4a4a;
      }

      .box *,
      .resource-card *,
      .card * {
        color: #f5f5f5 !important;
      }
    }
  </style>
</head>

<body class="roboto-regular">
  <nav class="navbar" role="navigation" aria-label="main navigation">
  <div class="navbar-brand">
    <a class="navbar-item montserrat" href="/">
      Unitime
    </a>

    <a role="button" class="navbar-burger" aria-label="menu" aria-expanded="false" data-target="navbarBasicExample">
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </a>
  </div>

  <div id="navbarBasicExample" class="navbar-menu">
    <div class="navbar-start">
      <a class="navbar-item montserrat" href="/calendar">
        Calendar
      </a>
      <a class="navbar-item montserrat" href="/resources">
        Resources
      </a>
    </div>
  </div>

  <script type="text/javascript">
    // Lifted from bulma.io, makes clicking on the hamburger work
    document.addEventListener('DOMContentLoaded', () => {
      // Get all "navbar-burger" elements
      const $navbarBurgers = document.querySelectorAll('.navbar-burger')
      // Add a click event on each of them
      $navbarBurgers.forEach( el => {
        el.addEventListener('click', () => {
          // Get the target from the "data-target" attribute
          const target = el.dataset.target;
          const $target = document.getElementById(target);
          // Toggle the "is-active" class on both the "navbar-burger" and the "navbar-menu"
          el.classList.toggle('is-active');
          $target.classList.toggle('is-active');
        });
      });
    });
  </script>
</nav>
  <section class="section">
    <div class="container">
      <h1 class="title is-1 montserrat">{{ self.title() }}</h1>
      {% block content %}{% endblock %}
    </div>
  </section>
</body>
